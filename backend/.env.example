# Optional: leave both blank to run entirely on the rule-based intent parser (no cost, no key needed)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: defaults to local SQLite file. Set this on Render to a Postgres URL, e.g.
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# CORS: set to your deployed frontend URL in production, e.g. https://paypilot.vercel.app
FRONTEND_ORIGIN=*
